# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
# .env 는 .gitignore 에 들어 있어서 git에 올라가지 않습니다.

# https://developer.spotify.com/dashboard 에서 앱을 만들면 나옵니다.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# https://www.last.fm/api/account/create 에서 발급합니다.
LASTFM_API_KEY=

# (선택) YouTube 플레이리스트 링크를 쓰려면 Google Cloud에서 YouTube Data API v3 키를 발급받아 넣으세요. 무료 일일 한도가 있어요.
YOUTUBE_API_KEY=

# 로그인 후 돌아올 주소. Spotify 대시보드에 등록한 Redirect URI와 똑같아야 합니다.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback
